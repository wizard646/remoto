{
  "expo": {
    "name": "Remoto",
    "slug": "remoto",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0f172a",
    "icon": "./icono.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.micontrolpc.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./icono.png",
        "backgroundColor": "#0f172a"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.micontrolpc.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./icono.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bbc468ba-6ded-4c40-bea0-36fb8e1fc9e0"
      }
    },
    "owner": "wxard"
  }
}
